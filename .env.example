# Copy to .env. Never commit .env.

# Fixed IP of the hub laptop on the local network (see docs/DECISIONS.md D2)
# Windows Mobile Hotspot is always 192.168.137.1. For a router, use the DHCP reservation.
HUB_IP=192.168.137.1
# Optional: other IPs/hostnames to include in the same certificate (comma separated)
CERT_EXTRA_HOSTS=
HTTPS_PORT=3443
SETUP_PORT=8080
# Optional: where hub.db lives (default server/data). Useful for a second test hub.
# DATA_DIR=
# Optional: where the certificate and the web build live (defaults: certs/ and web/dist). Set by the desktop app.
# CERTS_DIR=
# WEB_DIST=

# Host passcode for the big screen. Use something long; it is shared only with the host.
COORDINATOR_PASSCODE=change-me-to-a-long-passphrase
