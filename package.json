{
  "name": "pralayam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n web,hub -c cyan,green \"npm run dev -w web\" \"npm run dev -w server\"",
    "build": "npm run build -w shared && npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -b shared server && tsc -p web --noEmit",
    "certs": "tsx scripts/make-certs.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "sim": "tsx scripts/sim.ts",
    "e2e:screen": "node scripts/e2e-screen.mjs",
    "e2e": "node scripts/e2e-screen.mjs",
    "e2e:play": "node scripts/e2e-play.mjs",
    "e2e:deadzone": "node scripts/e2e-deadzone.mjs",
    "app": "node scripts/desktop.mjs",
    "app:check": "node scripts/desktop.mjs --check",
    "app:shortcut": "node scripts/desktop-shortcut.mjs",
    "e2e:desktop": "node scripts/e2e-desktop.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.6",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
